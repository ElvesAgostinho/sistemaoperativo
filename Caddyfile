# Proxy reverso com HTTPS automático (Let's Encrypt, sem configuração manual de
# certificados) para os 3 subdomínios do BusinessOS. Substitua <dominio> pelo
# domínio real antes de subir para o VPS (ex: app.suaempresa.co).
#
# meet.<dominio> só funciona depois de o stack oficial do Jitsi
# (github.com/jitsi/docker-jitsi-meet) estar a correr no mesmo VPS — ver
# Passo 0 do plano de implementação. Como esse stack é um projeto Docker
# Compose SEPARADO deste (não vive neste repositório), o container "web" dele
# só é alcançável por nome a partir daqui se os dois projetos partilharem uma
# rede Docker externa, por exemplo:
#   docker network create businessos_net
# ...e acrescentar "businessos_net" como rede externa tanto no
# docker-compose.yml deste repositório como no docker-compose.yml do Jitsi.

app.<dominio> {
    reverse_proxy frontend:80
}

api.<dominio> {
    reverse_proxy backend:3001
}

meet.<dominio> {
    reverse_proxy jitsi-web:80
}
